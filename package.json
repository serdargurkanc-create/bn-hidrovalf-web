{
  "name": "tema-v4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "bundle:motion": "esbuild lib/motion-entry.ts --bundle --minify --format=iife --outfile=public/motion.js --target=es2020 && esbuild lib/form-entry.ts --bundle --minify --format=iife --outfile=public/form.js --target=es2020",
    "defer-js": "python3 scripts/defer-next-js.py",
    "build": "npm run bundle:motion && next build --webpack && npm run defer-js",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
